pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Pulling latest code...'
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing npm packages...'
                sh 'npm install'
            }
        }

        stage('Run Tests') {
            steps {
                echo 'Running tests...'
                sh 'npm test'
            }
        }

       stage('Deploy') {
    steps {
        echo 'Deploying app...'
        sh '''
            # Kill any existing instance
            pkill -f "node app.js" || true
            sleep 1

            # setsid fully detaches from Jenkins shell session
            setsid nohup node /var/lib/jenkins/workspace/hello-world-nodeJS/app.js \
                > /tmp/hello-app.log 2>&1 &

            sleep 2

            # Verify it actually started
            if curl -s http://localhost:3000 > /dev/null; then
                echo "App is live on port 3000"
            else
                echo "App failed to start - check /tmp/hello-app.log"
                cat /tmp/hello-app.log
                exit 1
            fi
        '''
    }
}
    }

    post {
        success {
            echo 'Pipeline SUCCESS - app is live!'
        }
        failure {
            echo 'Pipeline FAILED - check the logs above'
        }
    }
}
